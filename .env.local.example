# Copy this to .env.local and fill in your values
# Get these from: https://supabase.com/dashboard/project/qnwizieggisnbjqyxrjo/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://qnwizieggisnbjqyxrjo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Auth — comma-separated list of allowed emails
ALLOWED_EMAILS=you@example.com

# Alpaca Paper Trading (server-side only — DO NOT add NEXT_PUBLIC_ prefix)
# Get these from: https://app.alpaca.markets/paper/dashboard/overview
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_API_SECRET=your_alpaca_api_secret

# TradeZero (via proxy — server-side only)
TZ_PROXY_URL=your_proxy_url
TZ_PROXY_API_KEY=your_proxy_api_key
TZ_ACCOUNT_ID=your_account_id

# Polygon (server-side only)
# Get from: https://polygon.io/dashboard/keys
POLYGON_API_KEY=your_polygon_api_key

# TradePod RVOL feed for morning email scanner (server-side only)
TRADEPOD_RVOL_TOP_STOCKS_URL=https://tradepod.ai/api/scanner/rvol/top-stocks
TRADEPOD_RVOL_READ_SECRET=your_tradepod_rvol_read_secret
TRADEPOD_RVOL_MAX_AGE_MINUTES=240

# AskEdgar (server-side only)
# Get from: https://askedgar.readme.io/docs/getting-started
ASKEDGAR_API_KEY=your_askedgar_api_key

# OneSignal Web Push
# Get from: https://dashboard.onesignal.com/
NEXT_PUBLIC_ONESIGNAL_APP_ID=your_onesignal_app_id
NEXT_PUBLIC_ONESIGNAL_SAFARI_WEB_ID=your_onesignal_safari_web_id
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key

# Resend RVOL Email Alerts
# Get from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key
RVOL_ALERTS_FROM_EMAIL="Longboard Alerts <alerts@yourdomain.com>"

# Slack RVOL Alerts
# Use an incoming webhook for the Pedro/Longboard Slack app and target channel.
SLACK_RVOL_WEBHOOK_URL=your_slack_rvol_webhook_url
# Slack Bugs Intake
# Use a Slack bot token with channel read/history scopes, pointed at the #bugs channel ID.
SLACK_BUGS_BOT_TOKEN=your_slack_bugs_bot_token
SLACK_BUGS_CHANNEL_ID=your_slack_bugs_channel_id
SLACK_BUGS_IMPORT_LOOKBACK_HOURS=48
# Delivery skips stale/backfilled RVOL signals older than this many minutes.
RVOL_ALERT_MAX_AGE_MINUTES=5

# Daily Google Analytics report
# Service account must have Viewer access to the GA4 property.
GA4_PROPERTY_ID=your_ga4_property_id
GA4_CLIENT_EMAIL=your_service_account_email
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----\n"
# First test delivery target: Buddyclaw Slack #rob-liz.
BUDDYCLAW_ROB_LIZ_WEBHOOK_URL=your_buddyclaw_rob_liz_webhook_url

# Finnhub (server-side only)
# Get from: https://finnhub.io/dashboard
FINNHUB_API_KEY=your_finnhub_api_key

# SEC (server-side only)
# EDGAR requires an identifying User-Agent header, ideally with contact info.
SEC_USER_AGENT="Longboard (you@example.com)"

# Exa.ai (server-side only)
# Get from: https://exa.ai/dashboard
EXA_API_KEY=your_exa_api_key

# Perplexity (server-side only)
# Get from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_api_key

# Anthropic (server-side only)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key
