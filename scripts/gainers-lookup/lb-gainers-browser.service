[Unit]
Description=Longboard: the dedicated Chromium the gainers lookup reads DilutionTracker in (#472)
# Optional. Not installed or enabled by anything: the lookup (lb-gainers-lookup) never starts, restarts
# or closes this browser itself. See README.md, "The DilutionTracker browser".
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/chromium --user-data-dir=%h/.config/longboard/gainers-lookup/browser --remote-debugging-port=9333 --remote-debugging-address=127.0.0.1 --no-first-run https://dilutiontracker.com/
Restart=no

[Install]
WantedBy=graphical-session.target
