[Unit]
Description=Longboard: send the Trading Desk a read-only TradeZero snapshot (#469)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# Node 22 or newer (it needs the built-in fetch and WebSocket). Change the path to your node if it isn't mise's.
ExecStart=%h/.local/share/mise/installs/node/latest/bin/node %h/projects/longboard/scripts/trading-desk-feed/feed.mjs
Restart=on-failure
# A missing or unreadable key or token file stops it; it tries again every 5 minutes.
RestartSec=300
# It never needs more rights than it starts with.
NoNewPrivileges=yes
# Logs: journalctl --user -u lb-trading-desk-feed

[Install]
WantedBy=default.target
